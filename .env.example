# Local development env example
# Copy to .env and fill values

# Vite (client) - must start with VITE_ to be exposed to client code
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_MP_PUBLIC_KEY=TEST-your-public-key

# Supabase CLI / Edge Function env (set in Supabase dashboard or via supabase env)
# These MUST NOT be committed to source control; use project secrets in Supabase
MP_ACCESS_TOKEN=TEST-tu-token-aqui
MP_CLIENT_ID=your-mercado-pago-client-id
MP_CLIENT_SECRET=your-mercado-pago-client-secret
APP_URL=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notes:
# - Set VITE_* vars locally before running `npm run dev` so the client can call Edge Functions.
# - Register this exact URI in the Mercado Pago application and set it in VITE_MP_REDIRECT_URI.
# - Configure MP_ACCESS_TOKEN and SUPABASE_SERVICE_ROLE_KEY as project secrets in Supabase for Edge Functions.
# - For testing Mercado Pago in sandbox, use the sandbox access token and prefer sandbox URLs returned by the function.

VITE_MP_REDIRECT_URI=http://localhost:5173/mp/callback
